{
	"name": "PvPoke",

	// A stock dev container base image (Debian, non-root vscode user with passwordless
	// sudo already set up) — no custom Dockerfile needed anymore now that the site is a
	// Node application. Node itself and the GitHub CLI come from Features.
	"image": "mcr.microsoft.com/devcontainers/base:bookworm",

	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "22",
			"pnpmVersion": "latest"
		},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	// Mount the whole repository so .git is present and VS Code's Source Control view
	// works. The path is kept from the PHP days so existing tooling and docs still apply.
	"workspaceMount": "source=${localWorkspaceFolder},target=/var/www/html/pvpoke,type=bind",
	"workspaceFolder": "/var/www/html/pvpoke",

	// Nothing has to run at container start: the dev server is started by hand with
	// `pnpm dev` (VS Code picks the forwarded port up automatically).
	"overrideCommand": true,

	"forwardPorts": [5173],
	"portsAttributes": {
		"5173": {
			"label": "PvPoke — pnpm dev",
			"onAutoForward": "notify"
		}
	},

	"remoteUser": "vscode",

	// Runs once after the container is created, as vscode: installs the dependencies and
	// the Claude Code tooling (see post-create.sh).
	"postCreateCommand": "bash .devcontainer/post-create.sh",

	"customizations": {
		"vscode": {
			"extensions": [
				"svelte.svelte-vscode"
			]
		}
	}
}
