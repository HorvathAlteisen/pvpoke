# Copy to .env and adjust. All variables are optional; the site runs without any of them.

# Google Analytics measurement ID (legacy $UA in modules/config.php). Empty disables nothing:
# the gtag snippet is still emitted with an empty id, exactly like the PHP site did.
PVPOKE_GA_ID=

# Google AdSense client id (legacy $GOOGLE_AD_CLIENT). Currently unused: all ad slots are empty.
PVPOKE_GOOGLE_AD_CLIENT=

# MySQL connection for the training-battle telemetry (data/training/postTraining.php,
# data/training/getTraining.php). Schema: static/data/training/training.sql
DB_HOST=localhost
DB_NAME=pvpoke_training
DB_USER=root
DB_PASS=

# Set to 1 to expose the developer/content tools (data/write.php, data/compile.php,
# data/movesets.php, data/parse*.php, data/groupCookie.php, data/training/getTraining.php)
# outside of `pnpm dev`. They return 404 otherwise.
PVPOKE_DEV_TOOLS=0

# Public origin, required by adapter-node in production for correct absolute URLs
# (the `host` JS global). See https://svelte.dev/docs/kit/adapter-node#Environment-variables
ORIGIN=http://localhost:3000
