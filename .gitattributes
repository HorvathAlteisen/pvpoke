# Windows checks this repository out with CRLF (core.autocrlf=true), while the
# Linux git inside the dev container converts nothing. Both look at the same
# bind-mounted working tree, so every text file in it showed up as modified on
# the container side — 457 of them, none of them actually changed.
#
# Pinning the checkout to LF gives both sides one representation on disk. This
# normalises nothing: `git ls-files --eol` reports zero files stored with CRLF,
# so the index is untouched and no diff is created against upstream.
* text=auto eol=lf

# Batch files are the exception — cmd.exe is the one consumer that can still
# trip over LF endings (src/scripts/cupwizard.cmd).
*.cmd text eol=crlf
*.bat text eol=crlf
